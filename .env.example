# Wayfound agent supervision (optional) — copy these lines into your local .env.
# Supervision is a silent no-op until WAYFOUND_API_KEY is set.

# Ask a Wayfound administrator to create an API key (app.wayfound.ai → API).
WAYFOUND_API_KEY=your-wayfound-api-key-here

# Optional — defaults to the registered "HonTe Portfolio AI" (MongoDB) agent.
# Only set this to record sessions against a different Wayfound agent.
# WAYFOUND_AGENT_ID=fb0d89cf-f0c1-4936-b3a9-9dd9bf7b315a
