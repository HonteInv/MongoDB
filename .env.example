# Optional local overrides. Copy into .env (never commit .env).

# ── Wayfound agent supervision ──────────────────────────────────────────
# Supervision is ON by default: the key and agent id are hardcoded in
# wayfound_monitor.py, so nothing here is required. Set these only to
# override the built-ins.

# Use a rotated key without editing code:
# WAYFOUND_API_KEY=your-rotated-key-here

# Record against a different Wayfound agent:
# WAYFOUND_AGENT_ID=fb0d89cf-f0c1-4936-b3a9-9dd9bf7b315a

# Turn supervision off entirely:
# WAYFOUND_DISABLED=true

# ── App credentials (needed for local runs and audit_data.py) ───────────
# MONGO_URI_USER=...
# MONGO_URI_ADMIN=...
# CLAUDE_API_KEY=...
# GEMINI_API_KEY=...
